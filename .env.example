# === API Keys ===
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# === DeepBrain AI Human Web SDK (aihuman.aistudios.com) ===
# userKey는 서버 비밀 — 절대 NEXT_PUBLIC_*로 노출하지 말 것
DEEPBRAIN_APP_ID=
DEEPBRAIN_USER_KEY=

# === HeyGen Interactive Avatar Streaming API ===
# api_key는 서버 비밀, 클라이언트는 GET /api/heygen/token로 짧은 access token만 받음
HEYGEN_API_KEY=
HEYGEN_DEFAULT_AVATAR=June_HR_public

# === OpenAI — 페르소나 정적 초상화 (DALL-E 3) ===
# 미설정 시 빌더의 "초상화 생성" 버튼이 에러 메시지를 표시 (생성 불가)
OPENAI_API_KEY=
PORTRAIT_MODEL=dall-e-3

# === Supabase ===
SUPABASE_URL=https://vywypsfoizxikqrfzcbk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# === Server ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
